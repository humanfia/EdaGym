{"$id":"https://edagym.local/schemas/v1/trial_observation.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One final-candidate observation; invalid attempts remain in the ledger.","properties":{"block_id":{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","title":"Block Id","type":"string"},"cell_id":{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","title":"Cell Id","type":"string"},"difficulty_id":{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","title":"Difficulty Id","type":"string"},"engineering_layer":{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","title":"Engineering Layer","type":"string"},"failure_kind":{"anyOf":[{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","type":"string"},{"type":"null"}],"default":null,"title":"Failure Kind"},"model_id":{"maxLength":96,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","title":"Model Id","type":"string"},"outcome":{"title":"Outcome","type":"boolean"},"repetition_index":{"default":0,"minimum":0,"title":"Repetition Index","type":"integer"},"task_instance_digest":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Task Instance Digest","type":"string"},"valid":{"default":true,"title":"Valid","type":"boolean"}},"required":["model_id","cell_id","task_instance_digest","block_id","engineering_layer","difficulty_id","outcome"],"title":"TrialObservation","type":"object"}
